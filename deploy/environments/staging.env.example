# Template only. Use staging-only credentials/secrets, never copy production secrets here.
APP_NAME=FinPilot API
APP_VERSION=staging
ENVIRONMENT=staging
FINPILOT_HTTP_PORT=8103
FINPILOT_STATS_PORT=8413
RUNTIME_ENV_FILE=/opt/finpilot/deployment/staging.env
DATABASE_URL=postgresql+psycopg://finpilot_staging:password@example:5432/finpilot_staging?sslmode=verify-full
DATABASE_REQUIRE_SSL=true
PUBLIC_BASE_URL=http://127.0.0.1:8103
HTTPS_REQUIRED_IN_PRODUCTION=true
SECRET_KEY=REPLACE_WITH_SECRET_KEY
ADMIN_EMAIL=staging-admin@example.invalid
ADMIN_PASSWORD=PASSWORD
DATA_PROTECTION_KEY=REPLACE_WITH_FERNET_KEY
STORAGE_TYPE=local
STORAGE_PATH=/app/storage
AI_PROVIDER=mock
AI_API_KEY=
VERIFICATION_PROVIDER=mock
OCR_PROVIDER=mock
EXTRACTION_PROVIDER=mock
EMAIL_PROVIDER=mock
SMS_PROVIDER=mock
RATE_LIMIT_ENABLED=true
SECURITY_HEADERS_ENABLED=true
