# TEMPLATE ONLY. Use dedicated sandbox credentials and a dedicated database.
# Never point this file at production DATABASE_URL or production secrets.
APP_NAME=FinPilot Sandbox API
APP_VERSION=sandbox
ENVIRONMENT=testing
SANDBOX_ENABLED=true
DATABASE_URL=postgresql+psycopg://finpilot_sandbox:REPLACE_PASSWORD@localhost:5432/sandbox
DATABASE_REQUIRE_SSL=false
PUBLIC_BASE_URL=http://127.0.0.1:8102
HTTPS_REQUIRED_IN_PRODUCTION=true
SECRET_KEY=REPLACE_WITH_UNIQUE_RANDOM_SECRET
ADMIN_EMAIL=sandbox-admin@example.invalid
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DATA_PROTECTION_KEY=REPLACE_WITH_VALID_FERNET_KEY
STORAGE_TYPE=local
STORAGE_PATH=./storage-sandbox
VERIFICATION_PROVIDER=mock
OCR_PROVIDER=mock
EXTRACTION_PROVIDER=mock
AI_PROVIDER=mock
EMAIL_PROVIDER=mock
SMS_PROVIDER=mock
RATE_LIMIT_ENABLED=true
SECURITY_HEADERS_ENABLED=true
