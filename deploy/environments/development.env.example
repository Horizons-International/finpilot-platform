# Template only. Copy to the remote host as development.env and replace every placeholder.
APP_NAME=FinPilot API
APP_VERSION=development
ENVIRONMENT=development
FINPILOT_HTTP_PORT=8101
FINPILOT_STATS_PORT=8411
RUNTIME_ENV_FILE=/opt/finpilot/deployment/development.env
DATABASE_URL=postgresql+psycopg://finpilot_dev:password@example:5432/finpilot_dev?sslmode=prefer
DATABASE_REQUIRE_SSL=false
PUBLIC_BASE_URL=http://127.0.0.1:8101
HTTPS_REQUIRED_IN_PRODUCTION=true
SECRET_KEY=REPLACE_WITH_SECRET_KEY
ADMIN_EMAIL=dev-admin@example.invalid
ADMIN_PASSWORD=PASSWORD
DATA_PROTECTION_KEY=REPLACE_WITH_FERNET_KEY
STORAGE_TYPE=local
STORAGE_PATH=/app/storage
AI_PROVIDER=mock
AI_API_KEY=
VERIFICATION_PROVIDER=mock
OCR_PROVIDER=mock
EXTRACTION_PROVIDER=mock
EMAIL_PROVIDER=mock
SMS_PROVIDER=mock
RATE_LIMIT_ENABLED=true
SECURITY_HEADERS_ENABLED=true
