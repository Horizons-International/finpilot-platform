# TEMPLATE ONLY — provision production.env out-of-band from your secret manager.
# Do not commit real secrets. Replace all examples and validate against bank policy.
APP_NAME=FinPilot API
APP_VERSION=1.0.0
ENVIRONMENT=production
FINPILOT_HTTP_PORT=8104
FINPILOT_STATS_PORT=8414
RUNTIME_ENV_FILE=/opt/finpilot/deployment/production.env
DATABASE_URL=postgresql+psycopg://finpilot_prod:password@example:5432/finpilot_prod?sslmode=verify-full
DATABASE_REQUIRE_SSL=true
PUBLIC_BASE_URL=http://127.0.0.1:8104
HTTPS_REQUIRED_IN_PRODUCTION=true
SECRET_KEY=REPLACE_WITH_SECRET_KEY
ADMIN_EMAIL=bootstrap-admin@example.invalid
ADMIN_PASSWORD=PASSWORD
DATA_PROTECTION_KEY=REPLACE_WITH_FERNET_KEY
WEBHOOK_ENCRYPTION_KEY=REPLACE_WEBHOOK_KEY
STORAGE_TYPE=local
STORAGE_PATH=/app/storage
AI_PROVIDER=mock
AI_API_KEY=
VERIFICATION_PROVIDER=mock
OCR_PROVIDER=mock
EXTRACTION_PROVIDER=mock
EMAIL_PROVIDER=mock
SMS_PROVIDER=mock
RATE_LIMIT_ENABLED=true
SECURITY_HEADERS_ENABLED=true
