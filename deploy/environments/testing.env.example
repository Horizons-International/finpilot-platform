# Template only. Use a dedicated non-production database and credentials.
APP_NAME=FinPilot API
APP_VERSION=testing
ENVIRONMENT=testing
FINPILOT_HTTP_PORT=8102
FINPILOT_STATS_PORT=8412
RUNTIME_ENV_FILE=/opt/finpilot/deployment/testing.env
DATABASE_URL=postgresql+psycopg://finpilot_test:password@example:5432/finpilot_test?sslmode=require
DATABASE_REQUIRE_SSL=true
PUBLIC_BASE_URL=http://127.0.0.1:8102
HTTPS_REQUIRED_IN_PRODUCTION=true
SECRET_KEY=REPLACE_WITH_SECRET_KEY
ADMIN_EMAIL=test-admin@example.invalid
ADMIN_PASSWORD=PASSWORD
DATA_PROTECTION_KEY=REPLACE_WITH_FERNET_KEY
STORAGE_TYPE=local
STORAGE_PATH=/app/storage
AI_PROVIDER=mock
AI_API_KEY=
VERIFICATION_PROVIDER=mock
OCR_PROVIDER=mock
EXTRACTION_PROVIDER=mock
EMAIL_PROVIDER=mock
SMS_PROVIDER=mock
RATE_LIMIT_ENABLED=true
SECURITY_HEADERS_ENABLED=true
