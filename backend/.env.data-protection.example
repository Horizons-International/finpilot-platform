# Generate a Fernet key with:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store the key in the deployment secret manager for production.
DATA_PROTECTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# Production deployment requirements for startup validation.
DATABASE_REQUIRE_SSL=true
PUBLIC_BASE_URL=https://api.example.com
HTTPS_REQUIRED_IN_PRODUCTION=true
