# Application
APP_NAME=FinPilot API
APP_VERSION=1.0.0
# Use production in deployed bank environments; testing is intended for CI.
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/database_name

# Authentication / JWT
# Generate an unpredictable secret; production requires at least 32 characters.
# Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-secret-key
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# Administrator bootstrap credentials; use a unique strong password in production.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password

# Password security and login abuse protection
PASSWORD_MIN_LENGTH=12
LOGIN_FAILURE_THRESHOLD=5
LOGIN_FAILURE_WINDOW_MINUTES=15
SESSION_IDLE_TIMEOUT_MINUTES=60

# API request/rate protections (the app-level limiter is process-local).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS_PER_IP=3000
RATE_LIMIT_REQUESTS_PER_ROUTE=600
RATE_LIMIT_AUTH_REQUESTS=120
RATE_LIMIT_MAX_TRACKED_KEYS=20000
MAX_REQUEST_BODY_BYTES=12582912
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE_SECONDS=31536000

# File storage
STORAGE_TYPE=local
STORAGE_PATH=./storage
MAX_FILE_SIZE_MB=10

# Verification providers
VERIFICATION_PROVIDER=mock
OCR_PROVIDER=mock
EXTRACTION_PROVIDER=mock

# AI Provider
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_MODEL_VERSION=unspecified
AI_MAX_TOKENS=1000
AI_TEMPERATURE=0.0
AI_TIMEOUT=30
AI_MAX_CONTEXT_CHARACTERS=30000

# Communication Providers
EMAIL_PROVIDER=mock
SMS_PROVIDER=mock
EMAIL_FROM_ADDRESS=
SMS_FROM_NUMBER=

# SLA monitoring
SLA_APPROACHING_THRESHOLD_PERCENT=20.0
SLA_MONITOR_INTERVAL_SECONDS=60

# Reporting exports
REPORT_ASYNC_ROW_THRESHOLD=5000
REPORT_MAX_ROWS=100000
REPORT_EXPORT_INTERVAL_SECONDS=5

# Invitations
USER_INVITATION_EXPIRE_HOURS=48

# Webhook configuration; store real key material in your secret manager.
WEBHOOK_ENCRYPTION_KEY=
WEBHOOK_DELIVERY_INTERVAL_SECONDS=5
WEBHOOK_DELIVERY_TIMEOUT_SECONDS=10
WEBHOOK_MAX_DELIVERY_ATTEMPTS=8
WEBHOOK_RETRY_BASE_SECONDS=30
