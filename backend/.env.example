# Application
# Name displayed in API documentation and application metadata.
APP_NAME=FinPilot API

# Application version.
APP_VERSION=1.0.0

# Current environment: development, testing, or production.
ENVIRONMENT=development


# Database
# PostgreSQL connection string.
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/database_name


# Authentication / JWT
# Secret used to sign JWT tokens.
# Replace this value in actual environments.
SECRET_KEY=change-this-secret-key

# JWT access token lifetime in minutes.
JWT_EXPIRE_MINUTES=30


# Administrator
# Initial administrator email and password.
# Replace this value in actual environments.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password

# File storage
STORAGE_TYPE=local
STORAGE_PATH=./storage
MAX_FILE_SIZE_MB=10